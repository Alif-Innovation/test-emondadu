# API Configuration
VITE_API_URL=https://api.example.com
VITE_API_TIMEOUT=10000

# Application Environment
VITE_APP_NAME=Emondadu
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_LOGGING=true

# Regional Configuration
VITE_REGION=asia-southeast
VITE_TIMEZONE=Asia/Jakarta

# Map Configuration (if needed)
VITE_MAP_TOKEN=your_map_token_here
VITE_MAP_CENTER=[-7.0972,113.6130]

# Authentication
VITE_AUTH_PROVIDER=oauth2
VITE_AUTH_REDIRECT_URI=https://yourdomain.com/callback
